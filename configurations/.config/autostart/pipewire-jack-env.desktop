[Desktop Entry]
Type=Application
Name=PipeWire JACK Environment
Comment=Set LD_LIBRARY_PATH for JACK applications
Exec=sh -c 'sleep 2; MULTIARCH=$(dpkg-architecture -qDEB_HOST_MULTIARCH 2>/dev/null || echo "x86_64-linux-gnu"); export LD_LIBRARY_PATH="/usr/lib/${MULTIARCH}/pipewire-0.3/jack${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"; dbus-update-activation-environment --systemd LD_LIBRARY_PATH'
Hidden=false
NoDisplay=true
X-GNOME-Autostart-enabled=true
X-XFCE-Autostart-enabled=true
StartupNotify=false
